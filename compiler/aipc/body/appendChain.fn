fn appendChain(args List<Expr>, acc Expr, i I64) -> Expr
  "Fold args[i..] onto acc as listAppend(listAppend(acc, args[i]), args[i + 1]) and so on."
  pure
  fails
body
  if i >= listLength(args) then acc else appendChain(args, CallFn("listAppend", listAppend(listAppend(listEmpty(), acc), listGet(args, i))), i + 1)
