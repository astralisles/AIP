fn printBody(lines List<Text>, i I64, pending List<I64>, openIf Bool) -> Unit
  "Print the dump of every body line from index i, in order."
  effects terminal.write
  fails
body
  if i < listLength(lines) and textTrim(listGet(lines, i)) == "" then printBody(lines, i + 1, pending, openIf) else if i < listLength(lines) then printBodyLine(lines, i, stepBody(countSpaces(listGet(lines, i), 0), textTrim(listGet(lines, i)), pending, openIf))
