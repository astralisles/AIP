<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>aip</AssemblyName>
    <RootNamespace>Aip</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Short-lived tool that allocates a lot on big projects: server GC measured ~25% faster at 50k functions. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\std\**\*.fn" LinkBase="std" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
