<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>aip</AssemblyName>
    <RootNamespace>Aip</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Short-lived tool that allocates a lot on big projects: server GC measured ~25% faster at 50k functions. -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>
  <ItemGroup>
    <Content Include="..\std\**\*.fn" LinkBase="std" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\std\**\*.const" LinkBase="std" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\packages\**\*.fn" LinkBase="packages" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\packages\**\package.txt" LinkBase="packages" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\packages\**\Rt.cs" LinkBase="packages" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\spec.md" Link="spec.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- std files are grouped in folders (std/text, std/list, ...). Drop copies whose source was moved
       or deleted, or the compiler would load the old copy too and report duplicate names. -->
  <Target Name="RemoveStaleStd" BeforeTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_StdWanted Include="@(Content->'$(OutDir)%(Link)')" Condition="'%(Content.Extension)' == '.fn' or '%(Content.Extension)' == '.const'" />
      <_StdCopied Include="$(OutDir)std\**\*.fn" />
      <_StdCopied Include="$(OutDir)std\**\*.const" />
      <_StdStale Include="@(_StdCopied)" Exclude="@(_StdWanted)" />
    </ItemGroup>
    <Delete Files="@(_StdStale)" />
  </Target>
</Project>
