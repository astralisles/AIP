fn sliceEdges() -> Unit
  "Print text and list slices at and beyond their bounds (clamped, never an error)."
  effects terminal.write
  fails
body
  let t = "hello"
  let none = ""
  printLine("slice whole: [{textSlice(t, 0, 5)}] past end: [{textSlice(t, 3, 99)}] negative start: [{textSlice(t, -4, 2)}]")
  printLine("slice empty range: [{textSlice(t, 2, 2)}] reversed: [{textSlice(t, 4, 1)}] empty text: [{textSlice(none, 0, 3)}]")
  let r = listRange(0, 4)
  printLine("list slice: {listLength(listSlice(r, 1, 3))} past end: {listLength(listSlice(r, 2, 99))} reversed: {listLength(listSlice(r, 3, 1))}")
  printLine("empty list: {listLength(listReverse(listRange(0, 0)))} indexOf: {listIndexOf(listRange(0, 0), 1)}")
