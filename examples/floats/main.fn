fn main() -> Unit
  "Show F32 and F64 floats: literals, arithmetic, conversions."
  effects terminal.write
body
  printLine("F64 math: {half(5.0)}")
  printLine("F32 math: {numF32ToF64(third(1.0))}")
  printLine("I64 to F64: {numToF64(7) / 2.0}")
  printLine("F64 to I64 drops the fraction: {numFromF64(-2.75)}")
  printLine("negative: {-1.5}")
