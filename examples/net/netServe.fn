fn netServe(port Int) -> Unit
  "Serve one client: greet first, then echo every chunk it sends until it closes."
  effects tcp.listen, tcp.accept, tcp.send, tcp.receive, tcp.close, terminal.write
body
  let listener = tcpListen(port)
  let conn = tcpAccept(listener)
  tcpSend(conn, bytesEncode("welcome"))
  netEchoLoop(conn)
  tcpClose(conn)
  tcpStop(listener)
