fn main() -> Unit
  "Console and network demo: `net echo`, `net serve PORT`, `net request PORT`, `net udp-send PORT`, `net udp-receive PORT`."
  effects process.args, terminal.read, terminal.write, tcp.connect, tcp.listen, udp.send, udp.receive
body
  let mode = if argCount() > 0 then arg(0) else "help"
  let port = if argCount() > 1 then textToInt(arg(1)) else 9000
  let typed = if mode == "echo" then readLine() else ""
  let served = if mode == "serve" then tcpServeOnce(port, "pong") else ""
  let answer = if mode == "request" then tcpRequest("127.0.0.1", port, "ping") else ""
  let datagram = if mode == "udp-receive" then udpReceive(port, 10000) else ""
  if mode == "udp-send" then udpSend("127.0.0.1", port, "datagram") else noop()
  printLine("{mode}: typed=[{typed}] served=[{served}] answer=[{answer}] datagram=[{datagram}]")
