fn main() -> Unit
  "Show bit operations on sized whole numbers."
  effects terminal.write
  fails
body
  let flags = numToU8(12)
  printLine("and: {flags & 10}")
  printLine("or: {flags | 3}")
  printLine("xor: {flags ^ 5}")
  printLine("not U8: {~flags}")
  printLine("shl: {flags << 4}")
  printLine("shr signed keeps sign: {numToI8(-16) >> 2}")
  printLine("shl U32: {numToU32(1) << 31}")
  printLine("mask Int: {255 & 4095}")
