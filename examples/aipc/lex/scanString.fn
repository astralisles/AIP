fn scanString(src Text, i Int) -> Int
  "The position of the closing double quote, skipping backslash escapes."
  pure
body
  if i >= textLength(src) then i else if textCode(src, i) == charQuote then i else if textCode(src, i) == charBackslash then scanString(src, i + 2) else scanString(src, i + 1)
