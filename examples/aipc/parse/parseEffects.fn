fn parseEffects(toks List<Text>, pos Int, current Text, acc List<Text>) -> List<Text>
  "Read the rest of an `effects` line from pos: names such as `file.read`, separated by commas."
  pure
body
  let t = tokAt(toks, pos)
  let lineDone = t == "Newline" or t == "End"
  if lineDone and current == "" then acc else if lineDone or t == "Sym ," then parseEffectsAfterName(toks, pos, listAppend(acc, current)) else parseEffects(toks, pos + 1, "{current}{tokText(t)}", acc)
