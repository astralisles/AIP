fn joinTexts(items List<Text>, sep Text, i Int, acc Text) -> Text
  "acc followed by items from position i on, with sep between items."
  pure
body
  if i >= listLength(items) then acc else if i == 0 then joinTexts(items, sep, 1, listGet(items, 0)) else joinTexts(items, sep, i + 1, "{acc}{sep}{listGet(items, i)}")
