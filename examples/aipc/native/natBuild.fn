fn natBuild(dir Text, out Text) -> Unit
  "Compile the .fn files in a folder to a Windows .exe at out, without the C# compiler or any linker. Anything the native compiler cannot handle yet is reported as `native-unsupported`."
  effects file.read, file.write, terminal.write
  fails
body
  let fns = natLoadFns(dir, dirList(dir), 0, listEmpty())
  let problem = if natFnIndex(fns, "main", 0) < 0 then "there is no `main` function" else natCheckFns(fns, 0)
  if problem == "" then natWriteExe(out, natCompile(fns)) else printLine("error native-unsupported: {problem}\n  fix: build this project with the cs back end, or use only I64, Bool, Text, calls, let, if and printLine")
