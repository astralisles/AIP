fn parseBinary(toks List<Text>, pos I64, level I64) -> ExprParsed
  "Read an expression whose operators bind at operator level `level` or tighter (0 is the loosest)."
  pure
  fails
body
  if level >= 10 then parseUnary(toks, pos) else parseBinaryRest(toks, level, parseBinary(toks, pos, level + 1))
