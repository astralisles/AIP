fn binaryStep(toks List<Text>, level Int, left ExprParsed) -> ExprParsed
  "Read the operator after left and the operand on its right, and join them."
  pure
body
  let right = parseBinary(toks, left.next + 1, level + 1)
  ExprParsed(BinaryOp(tokText(tokAt(toks, left.next)), left.expr, right.expr), right.next)
