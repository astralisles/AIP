fn textPartsHole(raw Text, i I64, rel I64, cur Text, parts List<Expr>) -> List<Expr>
  "A `{` at i whose `}` is rel characters later (-1: none, which is an error in the C# parser)."
  pure
  fails
body
  if rel < 0 then textPartsEnd(cur, parts) else textPartsInterp(raw, i + rel, parseExprText(textSlice(raw, i + 1, i + rel)), cur, parts)
