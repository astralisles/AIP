fn stepValue(prefix Text, toks List<Text>, pos I64) -> BodyStep
  "Read the value of a statement; a `match` leaves its arms to the lines that follow (indented 4)."
  pure
  fails
body
  let v = parseExpr(toks, pos, true)
  BodyStep("stmt {prefix}{sexpr(v.expr)}", if isMatch(v.expr) then listAppend(listEmpty(), 4) else listEmpty(), false)
