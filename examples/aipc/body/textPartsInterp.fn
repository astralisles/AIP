fn textPartsInterp(raw Text, close Int, hole Expr, cur Text, parts List<Expr>) -> List<Expr>
  "Add the literal text so far (if any) and the hole, then go on after the `}` at index close."
  pure
  fails
body
  textPartsFrom(raw, close + 1, "", listAppend(if cur == "" then parts else listAppend(parts, Lit(cur)), hole))
