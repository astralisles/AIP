fn showOne(shapes List<Shape>, i I64) -> Unit
  "Print shape i, then the rest."
  effects terminal.write
  fails
body
  let shape = listGet(shapes, i)
  match shape
    Nothing() => printLine("(skipping an empty shape)")
    Circle(center, radius) => printLine(describe(shape))
    Rect(corner, width, height) => printLine(describe(shape))
    Dot(at) => printLine(describe(shape))
  showAll(shapes, i + 1)
